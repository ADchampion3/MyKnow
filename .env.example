# Local mock mode works without this file. Copy it to .env only when you need overrides.

# Optional local paths and ports
# DATABASE_URL=file:./data/myknow.db
# API_PORT=3001
# WEB_PORT=3000
# RESOURCE_STORAGE_DIR=./data/resources
# RESOURCE_MAX_BYTES=unlimited
# Use "unlimited" only for local development; use a positive byte count outside development.

# Optional model configuration (keep MODEL_API_KEY server-side)
# MODEL_PROVIDER=mock
# MODEL_NAME=myknow-mock
# MODEL_API_BASE_URL=
# MODEL_API_KEY=
# AI_EGRESS_MODE=allow_cloud

# Optional embedding/vector search configuration
# RETRIEVAL_VECTOR_ENABLED=true
# EMBEDDING_PROVIDER=mock
# EMBEDDING_MODEL=mock-hash-v1
# EMBEDDING_DIMENSIONS=32
# For openai/openai-compatible providers, set the endpoint below.
# EMBEDDING_API_BASE_URL=
# Keep API keys server-side; local compatible endpoints may leave this empty.
# EMBEDDING_API_KEY=
# Test-only failure injection: timeout or failed.
# EMBEDDING_FAILURE_MODE=

# Optional Agent policy; warn keeps citation issues from blocking a draft.
# AGENT_CITATION_POLICY=warn

# Optional OCR configuration
# PADDLE_OCR_TOKEN=
