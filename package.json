{
  "name": "myknow",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm --workspace apps/web run dev",
    "dev:api": "npm --workspace apps/api run dev",
    "dev:worker": "npm --workspace apps/worker run dev",
    "db:recreate": "node scripts/recreate-db.js",
    "db:cleanup-derived": "node scripts/cleanup-derived-data.js",
    "test": "vitest run",
    "eval:scifact:import": "node scripts/import-scifact.js",
    "eval:raw-hybrid:preflight": "node scripts/prepare-raw-hybrid-eval-embeddings.js --preflight",
    "eval:raw-hybrid:prepare": "node scripts/prepare-raw-hybrid-eval-embeddings.js",
    "eval:raw-hybrid": "vitest run --config evals/raw-hybrid-retrieval/vitest.config.js",
    "eval:raw-hybrid:preflight:configured": "node scripts/prepare-raw-hybrid-eval-embeddings.js --preflight",
    "eval:raw-hybrid:prepare:configured": "node scripts/prepare-raw-hybrid-eval-embeddings.js",
    "eval:raw-hybrid:configured": "vitest run --config evals/raw-hybrid-retrieval/vitest.config.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.1",
    "@nestjs/core": "^11.2.1",
    "@nestjs/platform-express": "^11.2.1",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.2",
    "next": "^16.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@sentry/node": "^10.72.0",
    "deepeval": "^0.9.13",
    "vitest": "^4.1.11"
  }
}
