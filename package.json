{
  "name": "myknow",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm --workspace apps/web run dev",
    "dev:api": "npm --workspace apps/api run dev",
    "dev:worker": "npm --workspace apps/worker run dev",
    "check:db": "node packages/db/src/self-check.js",
    "check:chunker": "node packages/db/src/chunker-check.js",
    "check:materials": "node scripts/materials-check.js",
    "check:ocr": "node scripts/ocr-contract.js && node scripts/ocr-materials-check.js && node scripts/ocr-worker-check.js && node scripts/ocr-api-check.js",
    "check:all": "npm run check:db && npm run check:chunker && npm run check:materials && npm run check:api && npm run check:worker && npm run check:ocr && npm run check:wiki",
    "check:api": "node scripts/api-contract.js",
    "check:worker": "node scripts/worker-check.js",
    "check:storage": "node scripts/storage-check.js",
    "check:wiki-contract": "node scripts/wiki-contract.js",
    "check:wiki-version": "node scripts/wiki-version-check.js",
    "check:wiki-citation": "node scripts/wiki-citation-check.js",
    "check:wiki-layout": "node scripts/wiki-layout-check.js",
    "check:wiki-impact": "node scripts/wiki-impact-check.js",
    "check:wiki-rebuild": "node scripts/wiki-rebuild-check.js",
    "check:wiki": "npm run check:wiki-version && npm run check:wiki-citation && npm run check:wiki-layout && npm run check:wiki-contract && npm run check:wiki-impact && npm run check:wiki-rebuild",
    "db:recreate": "node scripts/recreate-db.js",
    "trace:chunks": "node scripts/chunk-trace.js",
    "test": "npm run test --workspaces --if-present"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.1",
    "@nestjs/core": "^11.2.1",
    "@nestjs/platform-express": "^11.2.1",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.2",
    "next": "^16.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  }
}
