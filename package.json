{
  "name": "myknow",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm --workspace apps/web run dev",
    "dev:api": "npm --workspace apps/api run dev",
    "dev:worker": "npm --workspace apps/worker run dev",
    "check:db": "node packages/db/src/self-check.js",
    "check:chunker": "node packages/db/src/chunker-check.js",
    "check:materials": "node scripts/materials-check.js",
    "check:all": "npm run check:db && npm run check:chunker && npm run check:materials && npm run check:api && npm run check:worker",
    "check:api": "node scripts/api-contract.js",
    "check:worker": "node scripts/worker-check.js",
    "trace:chunks": "node scripts/chunk-trace.js",
    "test": "npm run test --workspaces --if-present"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.1",
    "@nestjs/core": "^11.2.1",
    "@nestjs/platform-express": "^11.2.1",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.2",
    "next": "^16.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  }
}
